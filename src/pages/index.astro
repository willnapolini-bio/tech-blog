---
// ---------------------------------------------------------------------------
// Index Page — Home page with hero, featured posts, and recent articles
// ---------------------------------------------------------------------------
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const publishedPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = publishedPosts[0];
const recentPosts = publishedPosts.slice(1, 4);
---

<Base
  title="TechPulse — Modern Web Development Guides, Tutorials & Comparisons"
  description="Practical guides, framework comparisons, and deployment tutorials for modern web developers. Learn Astro, Next.js, and more with in-depth, SEO-optimized content."
>
  <!-- ═══ Hero Section ═══ -->
  <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 px-6 py-16 md:py-24 text-white">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40"></div>
    <div class="relative mx-auto max-w-3xl text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-sm px-4 py-1.5 text-sm font-medium text-brand-100 border border-white/20">
        <span class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></span>
        New articles every week
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
        Build Faster.
        <span class="text-brand-200">Ship Smarter.</span>
      </h1>
      <p class="mt-4 text-lg md:text-xl text-brand-100 max-w-2xl mx-auto leading-relaxed">
        In-depth guides, honest framework comparisons, and deployment tutorials for
        developers who care about performance and SEO.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/blog" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50 transition-colors shadow-lg">
          Read the Blog
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="/rss.xml" class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-6 py-3 text-sm font-medium text-white hover:bg-white/10 transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5 3a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V5a2 2 0 00-2-2H5zm0 2h10v7h-2l-1 2H8l-1-2H5V5zm1 1v4h1l1 2h4l1-2h1V6H6z"/>
          </svg>
          Subscribe via RSS
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Sponsor / Affiliate Placement ═══ -->
  <div class="mt-10">
    <AffiliateBox
      title="Vercel — The Fastest Way to Deploy Your Frontend"
      description="Zero-config deployments, automatic previews, and global edge network. Deploy your Astro or Next.js site in seconds with Vercel."
      ctaText="Deploy for Free on Vercel"
      url="https://vercel.com?ref=your-affiliate-id"
      icon="rocket"
      badge="Sponsored"
    />
  </div>

  <!-- ═══ Featured Post ═══ -->
  {featuredPost && (
    <section class="mt-16" aria-label="Featured article">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Featured Article</h2>
      <a
        href={`/blog/${featuredPost.id}/`}
        class="group block rounded-2xl border border-slate-200 p-6 md:p-8 hover:border-brand-300 hover:shadow-xl transition-all duration-300"
      >
        <div class="flex flex-wrap gap-2 mb-3">
          {featuredPost.data.tags?.slice(0, 3).map((tag: string) => (
            <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 border border-brand-200">
              {tag}
            </span>
          ))}
        </div>
        <h3 class="text-2xl md:text-3xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
          {featuredPost.data.title}
        </h3>
        <p class="mt-3 text-slate-600 leading-relaxed">
          {featuredPost.data.description}
        </p>
        <div class="mt-4 flex items-center gap-4 text-sm text-slate-500">
          <time>
            {new Date(featuredPost.data.pubDate).toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            })}
          </time>
          <span>{featuredPost.data.author ?? 'TechPulse Team'}</span>
        </div>
      </a>
    </section>
  )}

  <!-- ═══ Recent Posts Grid ═══ -->
  {recentPosts.length > 0 && (
    <section class="mt-16" aria-label="Recent articles">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Recent Articles</h2>
        <a href="/blog" class="text-sm font-medium text-brand-600 hover:text-brand-700 transition-colors">
          View all →
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex flex-col rounded-xl border border-slate-200 p-5 hover:border-brand-300 hover:shadow-lg transition-all duration-200"
          >
            <div class="flex flex-wrap gap-1.5 mb-3">
              {post.data.tags?.slice(0, 2).map((tag: string) => (
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="font-semibold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2">
              {post.data.title}
            </h3>
            <p class="mt-2 flex-1 text-sm text-slate-500 line-clamp-3">
              {post.data.description}
            </p>
            <time class="mt-3 block text-xs text-slate-400">
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric',
              })}
            </time>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ═══ Ad Slot: Mid-Homepage ═══ -->
  <div class="mt-12">
    <AdSlot id="homepage-mid" slot="bottom" />
  </div>

  <!-- ═══ Topics Section ═══ -->
  <section class="mt-16" aria-label="Topics">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Browse by Topic</h2>
    <div class="flex flex-wrap gap-3">
      {['Astro', 'Next.js', 'Static Site Generators', 'Deployment', 'GitHub Pages', 'Performance', 'SEO', 'Web Development'].map((topic) => (
        <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:border-brand-300 hover:text-brand-600 transition-colors cursor-pointer">
          {topic}
        </span>
      ))}
    </div>
  </section>
</Base>
