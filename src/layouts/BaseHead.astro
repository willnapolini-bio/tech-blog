---
// ---------------------------------------------------------------------------
// BaseHead.astro — Dynamic <head> for SEO, OG, Twitter Cards, Performance
// ---------------------------------------------------------------------------
// This component generates all meta tags from frontmatter props.
// It is designed to achieve a 100/100 Lighthouse SEO score.

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: "website" | "article";
  pubDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  image = "/og-default.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = "website",
  pubDate,
  author = "TechPulse",
  tags = [],
} = Astro.props;

// Astro base path — e.g. "/" for root or "/tech-blog/" for project pages
const base = import.meta.env.BASE_URL;

// Build the full image URL from relative path
// Strip leading '/' so new URL() resolves relative to site (which includes base)
const imageURL = new URL(image.replace(/^\//, ''), Astro.site).href;

// Site name for OG
const siteName = "TechPulse";
---

<!-- Primary Meta Tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/icon-192.png`} />

<!-- Canonical URL — prevents duplicate content penalties -->
<link rel="canonical" href={canonicalURL} />

<!-- PWA Manifest -->
<link rel="manifest" href={`${base}manifest.json`} />
<meta name="theme-color" content="#4f46e5" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="TechPulse" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="application-name" content="TechPulse" />
<meta name="msapplication-TileColor" content="#4f46e5" />

<!-- Primary SEO Meta -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="generator" content={Astro.generator} />

// Keywords meta tag (still useful for some search engines and site search)
{tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

// Article-specific OG tags
{type === "article" && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === "article" && author && (
  <meta property="article:author" content={author} />
)}
{type === "article" &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

<!-- RSS Feed Discovery -->
<link rel="alternate" type="application/rss+xml" title={siteName} href={`${Astro.site}rss.xml`} />

<!-- Sitemap Discovery -->
<link rel="sitemap" href={`${base}sitemap-index.xml`} />

<!-- Preconnect to external origins (Core Web Vitals optimization) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Inter font — self-hosted or Google Fonts -->
<!-- For best performance, download Inter and self-host from /fonts/ instead -->
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║  GOOGLE ADSENSE                                                     ║
  ║  Replace the commented script below with your actual AdSense code.  ║
  ║  Place it here in <head> for optimal loading.                       ║
  ╚══════════════════════════════════════════════════════════════════════╝

  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
    crossorigin="anonymous"
  ></script>
-->

<!-- Global Styles -->
<style is:global>
  /* Base reset for consistent rendering */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  /* Accessible focus styles */
  :focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }

  /* Prose styles for Markdown content */
  .prose {
    max-width: 72ch;
    line-height: 1.75;
    color: #1e293b;
    font-size: 1.0625rem;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: #0f172a;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .prose h2 {
    font-size: 1.5rem;
    padding-bottom: 0.3em;
    border-bottom: 1px solid #e2e8f0;
  }

  .prose h3 {
    font-size: 1.25rem;
  }

  .prose p {
    margin-bottom: 1.25em;
  }

  .prose a {
    color: #4f46e5;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .prose a:hover {
    color: #3730a3;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.25em;
    padding-left: 1.625em;
  }

  .prose li {
    margin-bottom: 0.5em;
  }

  .prose ul li {
    list-style-type: disc;
  }

  .prose ol li {
    list-style-type: decimal;
  }

  .prose blockquote {
    border-left: 4px solid #6366f1;
    padding: 0.5em 1em;
    margin: 1.5em 0;
    background: #eef2ff;
    border-radius: 0 0.375rem 0.375rem 0;
    color: #3730a3;
    font-style: italic;
  }

  .prose code {
    background: #f1f5f9;
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }

  .prose pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1.25em;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  .prose pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: 0.875em;
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 1.5em 0;
    max-width: 100%;
    height: auto;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
  }

  .prose th,
  .prose td {
    border: 1px solid #e2e8f0;
    padding: 0.625em 1em;
    text-align: left;
  }

  .prose th {
    background: #f8fafc;
    font-weight: 600;
  }

  .prose hr {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 2em 0;
  }

  /* Ad slot styling */
  .ad-slot-container {
    margin: 2em 0;
    padding: 1rem;
    border: 1px dashed #cbd5e1;
    border-radius: 0.5rem;
    text-align: center;
    background: #f8fafc;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
