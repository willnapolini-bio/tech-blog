---
// ---------------------------------------------------------------------------
// AffiliateBox.astro — Reusable Affiliate Call-To-Action Component
// ---------------------------------------------------------------------------
// A styled, high-converting CTA box for promoting tech tools, hosting, SaaS, etc.
// Includes FTC-compliant affiliate disclaimer text.
//
// USAGE:
//   <AffiliateBox
//     title="Vercel — Deploy in Seconds"
//     description="The fastest way to deploy your frontend. Zero-config, instant rollbacks."
//     ctaText="Start Free on Vercel"
//     url="https://vercel.com?ref=your-affiliate-id"
//     icon="rocket"
//   />
//
// AVAILABLE ICONS: rocket, server, bolt, shield, code, globe, terminal, zap

interface Props {
  /** Product/service name shown as the box title */
  title: string;
  /** Short description of the product (1-2 sentences) */
  description: string;
  /** Button text */
  ctaText?: string;
  /** Affiliate URL — REPLACE with your actual affiliate link */
  url: string;
  /** Icon name from the built-in set */
  icon?: "rocket" | "server" | "bolt" | "shield" | "code" | "globe" | "terminal" | "zap";
  /** Optional badge text (e.g., "Sponsored", "Free Tier Available") */
  badge?: string;
  /** Additional CSS classes */
  className?: string;
}

const {
  title,
  description,
  ctaText = "Try It Free",
  url,
  icon = "rocket",
  badge,
  className = "",
} = Astro.props;

// Icon SVG paths mapped by name
const icons: Record<string, string> = {
  rocket: "M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z",
  server: "M21.75 17.25v-.228a4.5 4.5 0 00-.12-1.03l-2.268-9.64a3.375 3.375 0 00-3.285-2.602H7.923a3.375 3.375 0 00-3.285 2.602l-2.268 9.64a4.5 4.5 0 00-.12 1.03v.228m19.5 0a3 3 0 01-3 3H5.25a3 3 0 01-3-3m19.5 0a3 3 0 00-3-3H5.25a3 3 0 00-3 3m16.5 0h.008v.008h-.008v-.008zm-3 0h.008v.008h-.008v-.008z",
  bolt: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
  shield: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  code: "M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5",
  globe: "M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418",
  terminal: "M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0022.5 18V6a2.25 2.25 0 00-2.25-2.25H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25z",
  zap: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
};
---

<div class:list={["affiliate-box relative rounded-xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 shadow-sm hover:shadow-md transition-shadow duration-200", className]}>
  <!-- Optional Badge -->
  {badge && (
    <span class="absolute -top-2.5 right-4 inline-flex items-center rounded-full bg-brand-600 px-3 py-0.5 text-xs font-medium text-white shadow-sm">
      {badge}
    </span>
  )}

  <div class="flex items-start gap-4">
    <!-- Icon -->
    <div class="flex-shrink-0 flex h-12 w-12 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
      </svg>
    </div>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <h4 class="text-lg font-semibold text-slate-900">{title}</h4>
      <p class="mt-1 text-sm text-slate-600 leading-relaxed">{description}</p>

      <!-- CTA Button -->
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="mt-3 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {ctaText}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>

  <!-- FTC Affiliate Disclaimer -->
  <p class="mt-3 text-xs text-slate-400 border-t border-brand-100 pt-2">
    We may earn a commission if you purchase through links on this page. This does not affect our editorial independence.
  </p>
</div>
